                watchSync: { connected: false, provider: 'Strava', device: 'Galaxy Watch', lastSyncedAt: null },
                records: [
                    { id: 'r801', date: '2026-09-12', distance: 2540, device: 'Galaxy Watch', splits: makeSplits(2540, 138, 176) },
                    { id: 'r802', date: '2026-10-16', distance: 2590, device: 'Galaxy Watch', splits: makeSplits(2590, 136, 175) },
