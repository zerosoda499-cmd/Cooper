index.html<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>COOPER PRO | 팀 쿠퍼 테스트 누적 추적 & 워치 연동 플랫폼</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <!-- Google Fonts: Inter & Noto Sans KR -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Noto+Sans+KR:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Inter', 'Noto Sans KR', 'sans-serif'],
                    }
                }
            }
        }
    </script>
    <style>
        body {
            font-family: 'Inter', 'Noto Sans KR', sans-serif;
            background-color: #f8fafc;
            color: #0f172a;
        }
        ::-webkit-scrollbar { width: 6px; height: 6px; }
        ::-webkit-scrollbar-track { background: #f1f5f9; }
        ::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 9999px; }
        ::-webkit-scrollbar-thumb:hover { background: #94a3b8; }
        .fade-in { animation: fadeIn 0.25s ease-out forwards; }
        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(6px); }
            to { opacity: 1; transform: translateY(0); }
        }
    </style>
</head>
<body class="min-h-screen flex flex-col antialiased selection:bg-blue-100 selection:text-blue-900">

    <!-- 상단 네비게이션 바 -->
    <header class="sticky top-0 z-30 bg-white/90 backdrop-blur-md border-b border-slate-200">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between py-3 gap-3">
                <!-- 로고 & 브랜드 -->
                <div class="flex items-center justify-between">
                    <div class="flex items-center gap-2.5">
                        <div class="w-9 h-9 rounded-xl bg-gradient-to-br from-blue-600 to-indigo-700 flex items-center justify-center text-white shadow-sm">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
                            </svg>
                        </div>
                        <div>
                            <h1 class="text-lg font-extrabold tracking-tight text-slate-900 leading-none">COOPER <span class="text-blue-600">PRO</span></h1>
                            <p class="text-[11px] font-medium text-slate-500 mt-0.5">누적 성장 추적 · Apple/Galaxy 워치 호환</p>
                        </div>
                    </div>

                    <!-- 모바일용 액션 버튼 -->
                    <div class="flex sm:hidden items-center gap-1.5">
                        <button onclick="openWatchGuideModal()" class="p-2 rounded-xl bg-slate-100 text-slate-700 hover:bg-slate-200 transition" title="워치 연동 방법">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                        </button>
                        <button onclick="openRecordModal()" class="inline-flex items-center gap-1 px-3 py-2 rounded-xl bg-blue-600 text-white text-xs font-semibold shadow-sm hover:bg-blue-700 transition">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
                            기록 추가
                        </button>
                    </div>
                </div>

                <!-- 역할 전환 스위치 & 데스크톱 액션 -->
                <div class="flex items-center justify-between sm:justify-end gap-2.5">
                    <div class="inline-flex p-1 rounded-xl bg-slate-100 border border-slate-200/80 w-full sm:w-auto">
                        <button id="btn-role-manager" onclick="switchRole('manager')" class="flex-1 sm:flex-none px-4 py-1.5 rounded-lg text-xs sm:text-sm font-semibold transition-all duration-200 flex items-center justify-center gap-1.5">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/></svg>
                            팀 관리자
                        </button>
                        <button id="btn-role-player" onclick="switchRole('player')" class="flex-1 sm:flex-none px-4 py-1.5 rounded-lg text-xs sm:text-sm font-semibold transition-all duration-200 flex items-center justify-center gap-1.5">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
                            선수 개인
                        </button>
                    </div>

                    <button onclick="openWatchGuideModal()" class="hidden sm:inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl bg-slate-100 text-slate-700 text-sm font-semibold hover:bg-slate-200 transition">
                        <svg class="w-4 h-4 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                        워치 연동 가이드
                    </button>

                    <button onclick="openRecordModal()" class="hidden sm:inline-flex items-center gap-1.5 px-4 py-2 rounded-xl bg-blue-600 text-white text-sm font-semibold shadow-sm hover:bg-blue-700 active:scale-[0.98] transition">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
                        시계 기록 추가
                    </button>
                </div>
            </div>
        </div>
    </header>

    <!-- 메인 컨텐츠 영역 -->
    <main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-6">

        <!-- ========================================================= -->
        <!-- 1. 팀 관리자 대시보드 뷰 (MANAGER VIEW) -->
        <!-- ========================================================= -->
        <section id="view-manager" class="space-y-6 fade-in">
            <!-- 헤더 안내 & 기준 전환 -->
            <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-4">
                <div>
                    <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-semibold bg-blue-50 text-blue-700 border border-blue-200 mb-2">
                        <span class="w-1.5 h-1.5 rounded-full bg-blue-600 animate-pulse"></span>
                        관리자 모드 · 누적 체력 추적 & 평균 평가
                    </span>
                    <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight">구단 전체 성장 추적 & 심박 평가</h2>
                    <p class="text-sm text-slate-500 mt-1">누적된 쿠퍼 테스트 기록의 평균값과 직전 측정 대비 성장·퇴화 추이를 분석합니다. (최대심박 = 220 - 나이)</p>
                </div>

                <div class="flex flex-wrap items-center gap-2">
                    <!-- 최근 기록 vs 누적 평균 기준 전환 토글 -->
                    <div class="inline-flex p-1 rounded-xl bg-white border border-slate-200 shadow-sm">
                        <button id="btn-metric-latest" onclick="setMetricMode('latest')" class="px-3 py-1.5 rounded-lg text-xs font-bold transition">최근 측정 기준</button>
                        <button id="btn-metric-average" onclick="setMetricMode('average')" class="px-3 py-1.5 rounded-lg text-xs font-bold transition">누적 평균 기준</button>
                    </div>

                    <!-- 팀 전체 원클릭 자동 동기화 버튼 -->
                    <button id="btn-team-auto-sync" onclick="syncTeamAllWatches()" class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl bg-gradient-to-r from-orange-500 to-rose-500 text-white text-xs sm:text-sm font-bold hover:from-orange-600 hover:to-rose-600 active:scale-[0.98] transition shadow-sm">
                        <svg id="team-sync-icon" class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>
                        <span id="team-sync-label">팀 기록 원클릭 동기화</span>
                    </button>

                    <button onclick="exportCSV()" class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl bg-white border border-slate-200 text-slate-700 text-xs sm:text-sm font-semibold hover:bg-slate-50 transition shadow-sm">
                        <svg class="w-4 h-4 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/></svg>
                        CSV 내보내기
                    </button>
                    <button onclick="resetDemoData()" class="inline-flex items-center gap-1.5 px-3 py-2 rounded-xl bg-white border border-slate-200 text-slate-600 text-xs sm:text-sm font-medium hover:bg-slate-50 transition shadow-sm" title="샘플 누적 데이터로 초기화">
                        초기화
                    </button>
                </div>
            </div>

            <!-- 팀 KPI 요약 카드 4종 -->
            <div class="grid grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-4" id="manager-kpi-cards"></div>

            <!-- 팀 차트 섹션 -->
            <div class="grid grid-cols-1 lg:grid-cols-3 gap-5">
                <!-- 팀 전체 거리(최근 vs 누적평균) & %HRmax 비교 차트 -->
                <div class="lg:col-span-2 bg-white rounded-2xl border border-slate-200/90 p-5 shadow-sm">
                    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-4">
                        <div>
                            <h3 class="text-base font-bold text-slate-900">선수별 최근 거리 vs 누적 평균 & 심박 사용률</h3>
                            <p class="text-xs text-slate-500">파란 막대: 최근 거리 · 회색 막대: 누적 평균 거리 · 붉은 선: 평균 %HRmax</p>
                        </div>
                        <span class="text-xs font-medium px-2.5 py-1 rounded-lg bg-slate-100 text-slate-600 self-start">상위 10명 기준</span>
                    </div>
                    <div class="relative h-64 w-full">
                        <canvas id="teamOverviewChart"></canvas>
                    </div>
                </div>

                <!-- 팀 성장/퇴화 현황 & 심박 존 분포 -->
                <div class="bg-white rounded-2xl border border-slate-200/90 p-5 shadow-sm flex flex-col justify-between">
                    <div>
                        <h3 class="text-base font-bold text-slate-900 mb-1">구단 성장·퇴화 & 심박 강도</h3>
                        <p class="text-xs text-slate-500 mb-4">직전 측정 대비 컨디션 변화 및 심박 부하(%HRmax)</p>

                        <!-- 성장 / 유지 / 퇴화 요약 칩 -->
                        <div class="grid grid-cols-3 gap-2 mb-4" id="team-trend-summary"></div>

                        <div id="hr-zone-distribution" class="space-y-2.5"></div>
                    </div>
                    <div class="mt-4 pt-3 border-t border-slate-100 text-[11px] text-slate-500 leading-relaxed">
                        <strong class="text-slate-700">추적 팁:</strong> 거리가 늘고 <span class="text-emerald-600 font-semibold">%HRmax가 유지/감소</span>하면 진정한 심폐 성장입니다. 거리가 줄고 심박이 높다면 피로 누적(오버트레이닝)을 점검하세요.
                    </div>
                </div>
            </div>

            <!-- 구단 전체 선수 순위표 (Leaderboard) -->
            <div class="bg-white rounded-2xl border border-slate-200/90 shadow-sm overflow-hidden">
                <!-- 필터 & 검색 바 -->
                <div class="p-4 sm:p-5 border-b border-slate-100 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
                    <div class="flex items-center gap-2">
                        <h3 class="text-base sm:text-lg font-bold text-slate-900">전체 선수 누적 기록 및 순위표</h3>
                        <span id="total-players-badge" class="px-2 py-0.5 rounded-full text-xs font-bold bg-slate-100 text-slate-700">0명</span>
                    </div>
                    <div class="flex flex-wrap items-center gap-2">
                        <div class="relative flex-1 sm:w-44">
                            <input type="text" id="search-input" oninput="renderManagerDashboard()" placeholder="선수 이름 검색..." class="w-full pl-8 pr-3 py-1.5 text-xs sm:text-sm rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-blue-500/30 focus:border-blue-500">
                            <svg class="w-4 h-4 text-slate-400 absolute left-2.5 top-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
                        </div>
                        <select id="position-filter" onchange="renderManagerDashboard()" class="px-2.5 py-1.5 text-xs sm:text-sm rounded-xl border border-slate-200 bg-white text-slate-700">
                            <option value="ALL">전체 포지션</option>
                            <option value="FW">FW</option>
                            <option value="MF">MF</option>
                            <option value="DF">DF</option>
                            <option value="GK">GK</option>
                        </select>
                        <select id="trend-filter" onchange="renderManagerDashboard()" class="px-2.5 py-1.5 text-xs sm:text-sm rounded-xl border border-slate-200 bg-white text-slate-700">
                            <option value="ALL">전체 추이</option>
                            <option value="improving">성장 선수 (▲)</option>
                            <option value="declining">퇴화 주의 (▼)</option>
                        </select>
                        <select id="sort-select" onchange="renderManagerDashboard()" class="px-2.5 py-1.5 text-xs sm:text-sm rounded-xl border border-slate-200 bg-white text-slate-700">
                            <option value="rank">순위 순</option>
                            <option value="deltaDesc">성장폭 큰 순</option>
                            <option value="deltaAsc">퇴화폭 큰 순</option>
                            <option value="hrPercentDesc">%HRmax 높은 순</option>
                            <option value="hrPercentAsc">%HRmax 낮은 순</option>
                        </select>
                    </div>
                </div>

                <!-- 반응형 테이블 -->
                <div class="overflow-x-auto">
                    <table class="w-full text-left border-collapse">
                        <thead>
                            <tr class="bg-slate-50/80 border-b border-slate-200 text-[11px] sm:text-xs font-bold text-slate-500 uppercase tracking-wider">
                                <th class="py-3 px-4 text-center w-12">순위</th>
                                <th class="py-3 px-4">선수 (측정횟수)</th>
                                <th class="py-3 px-4 text-right">최근 기록</th>
                                <th class="py-3 px-4 text-right">누적 평균</th>
                                <th class="py-3 px-4 text-center">성장/퇴화 (직전 대비)</th>
                                <th class="py-3 px-4 text-right">최대심박 / 평균심박</th>
                                <th class="py-3 px-4 min-w-[165px]">심박 사용률 (%HRmax)</th>
                                <th class="py-3 px-4 text-center">누적 분석</th>
                            </tr>
                        </thead>
                        <tbody id="manager-table-body" class="divide-y divide-slate-100 text-sm"></tbody>
                    </table>
                </div>
            </div>
        </section>

        <!-- ========================================================= -->
        <!-- 2. 선수 개인 화면 뷰 (PLAYER VIEW) -->
        <!-- ========================================================= -->
        <section id="view-player" class="hidden space-y-6 fade-in max-w-4xl mx-auto">
            <!-- 선수 선택 바 -->
            <div class="bg-white rounded-2xl border border-slate-200 p-4 shadow-sm flex flex-col sm:flex-row sm:items-center justify-between gap-3">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-full bg-indigo-100 text-indigo-700 font-bold flex items-center justify-center text-sm" id="player-avatar">KM</div>
                    <div>
                        <p class="text-xs font-semibold text-slate-500">현재 로그인된 선수 계정</p>
                        <select id="player-selector" onchange="renderPlayerView()" class="text-base font-bold text-slate-900 bg-transparent focus:outline-none cursor-pointer pr-2"></select>
                    </div>
                </div>
                <div class="flex items-center gap-2 text-xs text-slate-500 bg-slate-50 px-3 py-2 rounded-xl border border-slate-100">
                    <span id="player-record-count-badge" class="font-bold text-blue-600">누적 0회</span>
                    <span>·</span>
                    <span>최근 측정: <strong id="player-test-date" class="text-slate-700">-</strong></span>
                </div>
            </div>

            <!-- 선수 개인용 원클릭 워치 자동 동기화 배너 카드 -->
            <div id="player-watch-sync-card" class="bg-white rounded-2xl border border-slate-200 p-4 shadow-sm flex flex-col sm:flex-row sm:items-center justify-between gap-3">
                <!-- JS에서 연동 상태(연결됨 / 미연결)에 따라 동적 렌더링 -->
            </div>

            <!-- 선수 핵심 요약 히어로 카드 -->
            <div class="bg-gradient-to-br from-slate-900 via-blue-950 to-indigo-950 rounded-3xl p-6 sm:p-8 text-white shadow-lg relative overflow-hidden">
                <div class="absolute -right-12 -top-12 w-48 h-48 rounded-full bg-blue-500/20 blur-2xl pointer-events-none"></div>
                <div class="relative z-10 flex flex-col md:flex-row md:items-center justify-between gap-6">
                    <div>
                        <div class="flex flex-wrap items-center gap-2 mb-3">
                            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-white/10 border border-white/15 text-xs font-semibold text-blue-200" id="player-grade-badge">등급</span>
                            <span id="player-trend-hero-badge" class="inline-flex items-center gap-1 px-3 py-1 rounded-full text-xs font-bold">추이</span>
                        </div>
                        <div class="flex items-baseline gap-3">
                            <h2 class="text-3xl sm:text-4xl font-extrabold tracking-tight flex items-baseline gap-1.5">
                                <span id="player-distance">0</span>
                                <span class="text-lg font-medium text-blue-200">m</span>
                            </h2>
                            <span class="text-xs sm:text-sm text-slate-300 font-medium">
                                (누적 평균 <strong id="player-avg-dist-hero" class="text-white">0m</strong>)
                            </span>
                        </div>
                        <p class="text-sm text-slate-300 mt-2" id="player-feedback-text"></p>
                    </div>

                    <!-- 내 팀 순위 & 개인 최고(PR) -->
                    <div class="flex items-center gap-4 bg-white/10 backdrop-blur-md border border-white/15 rounded-2xl p-4 sm:px-6 shrink-0">
                        <div class="text-center">
                            <p class="text-xs font-medium text-blue-200 uppercase">팀 내 순위</p>
                            <div class="flex items-baseline justify-center gap-1 mt-1">
                                <span class="text-3xl sm:text-4xl font-black text-white" id="player-rank">-</span>
                                <span class="text-xs sm:text-sm font-semibold text-slate-300" id="player-total-count">/ 0명</span>
                            </div>
                        </div>
                        <div class="h-10 w-px bg-white/20"></div>
                        <div class="text-center">
                            <p class="text-xs font-medium text-blue-200 uppercase">개인 최고(PR)</p>
                            <div class="flex items-baseline justify-center gap-1 mt-1">
                                <span class="text-xl sm:text-2xl font-extrabold text-amber-300" id="player-best-dist">-</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- 선수 개인 누적 평균 & 최근 지표 4종 -->
            <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 sm:gap-4">
                <div class="bg-white rounded-2xl border border-slate-200 p-4 shadow-sm">
                    <p class="text-xs font-semibold text-slate-500">누적 평균 거리</p>
                    <div class="flex items-baseline gap-1 mt-1">
                        <span class="text-xl sm:text-2xl font-extrabold text-blue-600" id="player-stat-avg-dist">-</span>
                        <span class="text-xs text-slate-500">m</span>
