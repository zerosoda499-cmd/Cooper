    <script>
        // ---------------------------------------------------------
        // 1. 누적 데이터 구조 및 초기 샘플 (선수별 3회차 누적 기록)
        // ---------------------------------------------------------
        const STORAGE_KEY = 'cooper_pro_longitudinal_v2';

        /** 거리 기반 자연스러운 400m 구간 심박수 생성 헬퍼 */
        function makeSplits(distance, startHr, endHr) {
            const points = [];
            for (let d = 400; d < distance; d += 400) points.push(d);
            if (points[points.length - 1] !== distance) points.push(distance);
            return points.map((dist, idx) => {
                const ratio = idx / Math.max(1, points.length - 1);
                const curve = Math.pow(ratio, 0.72);
                return { dist, hr: Math.round(startHr + (endHr - startHr) * curve) };
            });
        }

        const DEFAULT_PLAYERS = [
