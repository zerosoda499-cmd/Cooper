                ]
            }
        ];

        // 전역 상태 및 차트 인스턴스 변수
        let players = [];
        let currentRole = 'manager'; // 'manager' | 'player'
        let metricMode = 'latest';   // 'latest' | 'average'
        let selectedPlayerId = 'p1';
        let activeDetailPlayerId = null;
        let recordTargetMode = 'existing'; // 'existing' | 'new'
        let pendingConnectDevice = 'Apple Watch';
        let isSyncing = false;

        let teamOverviewChartInstance = null;
        let playerProgressChartInstance = null;
        let playerHrChartInstance = null;
        let detailHistoryChartInstance = null;
        let detailSplitsChartInstance = null;
        let bleDevice = null;

        // ---------------------------------------------------------
        // 2. 스포츠 생리학 & 누적 통계 계산
        // ---------------------------------------------------------
        function calcMaxHR(age) {
            return 220 - age;
        }

        function calcVO2Max(distance) {
            return Math.max(20, Number(((distance - 504.9) / 44.73).toFixed(1)));
        }

        function getCooperGrade(distance) {
            if (distance >= 3200) return { label: '최우수 (Elite)', bg: 'bg-emerald-50 text-emerald-700 border-emerald-200' };
            if (distance >= 2900) return { label: '우수 (Excellent)', bg: 'bg-blue-50 text-blue-700 border-blue-200' };
            if (distance >= 2600) return { label: '양호 (Good)', bg: 'bg-indigo-50 text-indigo-700 border-indigo-200' };
            if (distance >= 2300) return { label: '보통 (Average)', bg: 'bg-amber-50 text-amber-700 border-amber-200' };
            return { label: '보완 필요', bg: 'bg-rose-50 text-rose-700 border-rose-200' };
        }

        function getHRZone(pct) {
            if (pct >= 90) return { short: 'Z5 최대부하', barColor: 'bg-rose-500', badge: 'bg-rose-50 text-rose-700 border-rose-200' };
            if (pct >= 80) return { short: 'Z4 고강도', barColor: 'bg-orange-500', badge: 'bg-orange-50 text-orange-700 border-orange-200' };
            if (pct >= 70) return { short: 'Z3 유산소', barColor: 'bg-emerald-500', badge: 'bg-emerald-50 text-emerald-700 border-emerald-200' };
            if (pct >= 60) return { short: 'Z2 지구력', barColor: 'bg-blue-500', badge: 'bg-blue-50 text-blue-700 border-blue-200' };
            return { short: 'Z1 회복', barColor: 'bg-slate-400', badge: 'bg-slate-100 text-slate-600 border-slate-200' };
        }

        function calcPace(distance) {
            if (!distance || distance <= 0) return '-';
            const secPerKm = 720 / (distance / 1000);
            const min = Math.floor(secPerKm / 60);
            const sec = Math.round(secPerKm % 60);
            return `${min}'${sec.toString().padStart(2, '0')}"`;
        }

        /** 단일 회차 기록 지표 계산 */
        function enrichRecord(rec, maxHR) {
            const hrs = rec.splits.map(s => s.hr);
            const avgHR = Math.round(hrs.reduce((a, b) => a + b, 0) / hrs.length);
            const peakHR = Math.max(...hrs);
            const avgHRPercent = Number(((avgHR / maxHR) * 100).toFixed(1));
            const peakHRPercent = Number(((peakHR / maxHR) * 100).toFixed(1));
            const vo2max = calcVO2Max(rec.distance);
            return {
                ...rec,
                avgHR,
                peakHR,
                avgHRPercent,
                peakHRPercent,
                vo2max,
                grade: getCooperGrade(rec.distance),
                zone: getHRZone(avgHRPercent)
            };
        }

        /** 전체 선수의 누적 통계(평균, 성장/퇴화 추이, 순위) 산출 */
        function getEnrichedPlayers() {
            const enriched = players.map(p => {
                const maxHR = calcMaxHR(p.age);
                const sortedRecords = [...p.records]
                    .sort((a, b) => new Date(a.date) - new Date(b.date))
                    .map(r => enrichRecord(r, maxHR));

                const count = sortedRecords.length;
                const latest = sortedRecords[count - 1];
                const previous = count >= 2 ? sortedRecords[count - 2] : null;
                const first = sortedRecords[0];

                const avgDistAll = Math.round(sortedRecords.reduce((s, r) => s + r.distance, 0) / count);
                const avgHrAll = Math.round(sortedRecords.reduce((s, r) => s + r.avgHR, 0) / count);
                const avgHrPctAll = Number((sortedRecords.reduce((s, r) => s + r.avgHRPercent, 0) / count).toFixed(1));
                const avgVo2All = Number((sortedRecords.reduce((s, r) => s + r.vo2max, 0) / count).toFixed(1));
                const bestDist = Math.max(...sortedRecords.map(r => r.distance));

                const deltaDist = previous ? latest.distance - previous.distance : 0;
                const deltaHrPct = previous ? Number((latest.avgHRPercent - previous.avgHRPercent).toFixed(1)) : 0;
                const totalDeltaDist = count >= 2 ? latest.distance - first.distance : 0;

                let trendStatus = 'stable';
                if (deltaDist >= 15) trendStatus = 'improving';
                else if (deltaDist <= -15) trendStatus = 'declining';

                const displayDist = metricMode === 'latest' ? latest.distance : avgDistAll;
                const displayHr = metricMode === 'latest' ? latest.avgHR : avgHrAll;
                const displayHrPct = metricMode === 'latest' ? latest.avgHRPercent : avgHrPctAll;
                const displayZone = getHRZone(displayHrPct);
                const displayGrade = getCooperGrade(displayDist);

                return {
                    ...p,
                    maxHR,
                    records: sortedRecords,
                    count,
                    latest,
                    previous,
                    avgDistAll,
                    avgHrAll,
                    avgHrPctAll,
                    avgVo2All,
                    bestDist,
                    deltaDist,
                    deltaHrPct,
                    totalDeltaDist,
                    trendStatus,
                    displayDist,
                    displayHr,
                    displayHrPct,
                    displayZone,
                    displayGrade
                };
            });

            const ranked = [...enriched].sort((a, b) => {
                if (b.displayDist !== a.displayDist) return b.displayDist - a.displayDist;
                return a.displayHrPct - b.displayHrPct;
            });
            ranked.forEach((p, idx) => { p.rank = idx + 1; });

            return ranked;
        }

        // ---------------------------------------------------------
        // 3. 스토리지 로드/저장 & 초기화
        // ---------------------------------------------------------
        function loadData() {
            try {
                const saved = localStorage.getItem(STORAGE_KEY);
                if (saved) {
                    const parsed = JSON.parse(saved);
                    if (Array.isArray(parsed) && parsed.length > 0 && parsed[0].records) {
                        players = parsed.map(p => ({
                            ...p,
                            watchSync: p.watchSync || {
                                connected: true,
                                provider: 'Strava',
                                device: (p.records[p.records.length - 1] && p.records[p.records.length - 1].device) || 'Apple Watch',
                                lastSyncedAt: null
                            }
                        }));
                        return;
                    }
                }
            } catch (e) { console.error(e); }
            players = JSON.parse(JSON.stringify(DEFAULT_PLAYERS));
            saveData();
        }

        function saveData() {
            try { localStorage.setItem(STORAGE_KEY, JSON.stringify(players)); } catch (e) {}
        }

        function resetDemoData() {
            players = JSON.parse(JSON.stringify(DEFAULT_PLAYERS));
            saveData();
            selectedPlayerId = players[0].id;
            renderAll();
            showToast('3회차 누적 샘플 데이터로 초기화되었습니다.', 'info');
        }

        // ---------------------------------------------------------
        // 4. 화면 및 모드 전환
        // ---------------------------------------------------------
        function switchRole(role) {
            currentRole = role;
            const managerView = document.getElementById('view-manager');
            const playerView = document.getElementById('view-player');
            const btnManager = document.getElementById('btn-role-manager');
            const btnPlayer = document.getElementById('btn-role-player');

            if (role === 'manager') {
                managerView.classList.remove('hidden');
                playerView.classList.add('hidden');
                btnManager.className = 'flex-1 sm:flex-none px-4 py-1.5 rounded-lg text-xs sm:text-sm font-bold transition-all duration-200 flex items-center justify-center gap-1.5 bg-white text-blue-700 shadow-sm';
                btnPlayer.className = 'flex-1 sm:flex-none px-4 py-1.5 rounded-lg text-xs sm:text-sm font-semibold transition-all duration-200 flex items-center justify-center gap-1.5 text-slate-600 hover:text-slate-900';
                setMetricMode(metricMode);
            } else {
                managerView.classList.add('hidden');
                playerView.classList.remove('hidden');
                btnPlayer.className = 'flex-1 sm:flex-none px-4 py-1.5 rounded-lg text-xs sm:text-sm font-bold transition-all duration-200 flex items-center justify-center gap-1.5 bg-white text-blue-700 shadow-sm';
                btnManager.className = 'flex-1 sm:flex-none px-4 py-1.5 rounded-lg text-xs sm:text-sm font-semibold transition-all duration-200 flex items-center justify-center gap-1.5 text-slate-600 hover:text-slate-900';
                populatePlayerSelector();
                renderPlayerView();
            }
        }

        function setMetricMode(mode) {
            metricMode = mode;
            const btnLatest = document.getElementById('btn-metric-latest');
            const btnAvg = document.getElementById('btn-metric-average');
            if (mode === 'latest') {
                btnLatest.className = 'px-3 py-1.5 rounded-lg text-xs font-bold transition bg-blue-600 text-white shadow-sm';
                btnAvg.className = 'px-3 py-1.5 rounded-lg text-xs font-bold transition text-slate-600 hover:text-slate-900';
            } else {
                btnAvg.className = 'px-3 py-1.5 rounded-lg text-xs font-bold transition bg-blue-600 text-white shadow-sm';
                btnLatest.className = 'px-3 py-1.5 rounded-lg text-xs font-bold transition text-slate-600 hover:text-slate-900';
            }
            renderManagerDashboard();
        }

        function renderAll() {
            if (currentRole === 'manager') renderManagerDashboard();
            else {
                populatePlayerSelector();
                renderPlayerView();
            }
        }

        // ---------------------------------------------------------
        // 5. 팀 관리자 대시보드 렌더링
        // ---------------------------------------------------------
        function renderManagerDashboard() {
            const allPlayers = getEnrichedPlayers();
            const searchQuery = document.getElementById('search-input').value.trim().toLowerCase();
            const posFilter = document.getElementById('position-filter').value;
            const trendFilter = document.getElementById('trend-filter').value;
            const sortBy = document.getElementById('sort-select').value;

            renderManagerKPIs(allPlayers);
            renderTeamTrendAndZones(allPlayers);
            renderTeamOverviewChart(allPlayers);

            let filtered = allPlayers.filter(p => {
                const matchName = p.name.toLowerCase().includes(searchQuery);
                const matchPos = posFilter === 'ALL' || p.position === posFilter;
                const matchTrend = trendFilter === 'ALL' || p.trendStatus === trendFilter;
                return matchName && matchPos && matchTrend;
            });

            filtered.sort((a, b) => {
                if (sortBy === 'rank') return a.rank - b.rank;
                if (sortBy === 'deltaDesc') return b.deltaDist - a.deltaDist;
                if (sortBy === 'deltaAsc') return a.deltaDist - b.deltaDist;
                if (sortBy === 'hrPercentDesc') return b.displayHrPct - a.displayHrPct;
                if (sortBy === 'hrPercentAsc') return a.displayHrPct - b.displayHrPct;
                return a.rank - b.rank;
            });

            document.getElementById('total-players-badge').textContent = `${filtered.length}명`;

            const connectedCount = allPlayers.filter(p => p.watchSync && p.watchSync.connected).length;
            const teamSyncLabel = document.getElementById('team-sync-label');
            if (teamSyncLabel && !isSyncing) {
                teamSyncLabel.textContent = `팀 기록 원클릭 동기화 (${connectedCount}/${allPlayers.length}명 연동)`;
            }

            const tbody = document.getElementById('manager-table-body');
            if (filtered.length === 0) {
                tbody.innerHTML = `<tr><td colspan="8" class="py-10 text-center text-slate-400 text-sm">조건에 맞는 선수가 없습니다.</td></tr>`;
                return;
            }

            tbody.innerHTML = filtered.map(p => {
                let rankBadge = `<span class="inline-flex items-center justify-center w-7 h-7 rounded-full text-xs font-bold bg-slate-100 text-slate-600">${p.rank}</span>`;
                if (p.rank === 1) rankBadge = `<span class="inline-flex items-center justify-center w-7 h-7 rounded-full text-xs font-extrabold bg-amber-100 text-amber-700 border border-amber-300">1</span>`;
                else if (p.rank === 2) rankBadge = `<span class="inline-flex items-center justify-center w-7 h-7 rounded-full text-xs font-extrabold bg-slate-200 text-slate-700 border border-slate-300">2</span>`;
                else if (p.rank === 3) rankBadge = `<span class="inline-flex items-center justify-center w-7 h-7 rounded-full text-xs font-extrabold bg-orange-100 text-orange-700 border border-orange-300">3</span>`;

                let trendHtml = `<span class="inline-flex items-center gap-0.5 px-2 py-0.5 rounded-md text-xs font-bold bg-slate-100 text-slate-600">유지 0m</span>`;
                if (p.count < 2) {
                    trendHtml = `<span class="text-xs text-slate-400">1회차 (기준)</span>`;
                } else if (p.deltaDist > 0) {
                    trendHtml = `
                        <span class="inline-flex items-center gap-0.5 px-2 py-0.5 rounded-md text-xs font-extrabold bg-emerald-50 text-emerald-700 border border-emerald-200">
                            ▲ +${p.deltaDist}m
                        </span>
                        <div class="text-[10px] text-slate-400 mt-0.5">심박 ${p.deltaHrPct > 0 ? '+' : ''}${p.deltaHrPct}%p</div>
                    `;
                } else if (p.deltaDist < 0) {
                    trendHtml = `
                        <span class="inline-flex items-center gap-0.5 px-2 py-0.5 rounded-md text-xs font-extrabold bg-rose-50 text-rose-700 border border-rose-200">
                            ▼ ${p.deltaDist}m
                        </span>
                        <div class="text-[10px] text-slate-400 mt-0.5">심박 ${p.deltaHrPct > 0 ? '+' : ''}${p.deltaHrPct}%p</div>
                    `;
                }

                const barWidth = Math.min(100, Math.max(0, p.displayHrPct));

                return `
                    <tr class="hover:bg-blue-50/40 transition-colors cursor-pointer group" onclick="openDetailModal('${p.id}')">
                        <td class="py-3.5 px-4 text-center">${rankBadge}</td>
                        <td class="py-3.5 px-4">
                            <div class="flex items-center gap-2.5">
                                <div class="w-8 h-8 rounded-full bg-slate-100 text-slate-700 font-bold text-xs flex items-center justify-center shrink-0 group-hover:bg-blue-100 group-hover:text-blue-700 transition">
                                    ${p.name.slice(0, 2)}
                                </div>
                                <div>
                                    <div class="font-bold text-slate-900 flex items-center gap-1.5">
                                        ${p.name}
                                        <span class="text-[10px] font-bold px-1.5 py-0.5 rounded bg-slate-100 text-slate-600">${p.count}회</span>
                                        ${p.watchSync && p.watchSync.connected
                                            ? `<span class="text-[10px] font-bold px-1.5 py-0.5 rounded bg-orange-50 text-orange-600 border border-orange-200" title="${p.watchSync.device} 자동연동 중">⌚ 자동</span>`
                                            : `<span class="text-[10px] font-semibold px-1.5 py-0.5 rounded bg-slate-100 text-slate-400">미연동</span>`
                                        }
                                    </div>
                                    <div class="text-xs text-slate-500">${p.position} · 만 ${p.age}세</div>
                                </div>
                            </div>
                        </td>
                        <td class="py-3.5 px-4 text-right">
                            <div class="font-extrabold ${metricMode === 'latest' ? 'text-blue-700 text-base' : 'text-slate-700'}">${p.latest.distance.toLocaleString()}<span class="text-xs font-normal text-slate-400 ml-0.5">m</span></div>
                            <div class="text-[10px] text-slate-400">${p.latest.date}</div>
                        </td>
                        <td class="py-3.5 px-4 text-right">
                            <div class="font-extrabold ${metricMode === 'average' ? 'text-blue-700 text-base' : 'text-slate-700'}">${p.avgDistAll.toLocaleString()}<span class="text-xs font-normal text-slate-400 ml-0.5">m</span></div>
                            <div class="text-[10px] text-slate-400">최고 ${p.bestDist.toLocaleString()}m</div>
                        </td>
                        <td class="py-3.5 px-4 text-center">${trendHtml}</td>
                        <td class="py-3.5 px-4 text-right">
                            <div class="font-bold text-slate-800">${p.maxHR} <span class="text-xs font-normal text-slate-400">max</span></div>
                            <div class="text-xs font-bold text-rose-600">${p.displayHr} <span class="text-[10px] font-normal text-slate-400">bpm (${metricMode === 'latest' ? '최근' : '평균'})</span></div>
                        </td>
                        <td class="py-3.5 px-4">
                            <div class="flex items-center justify-between text-xs mb-1">
                                <span class="font-extrabold text-slate-900">${p.displayHrPct}%</span>
                                <span class="text-[10px] font-bold px-1.5 py-0.5 rounded border ${p.displayZone.badge}">${p.displayZone.short}</span>
                            </div>
                            <div class="w-full h-2 bg-slate-100 rounded-full overflow-hidden">
                                <div class="h-full rounded-full ${p.displayZone.barColor} transition-all duration-500" style="width: ${barWidth}%"></div>
                            </div>
                        </td>
                        <td class="py-3.5 px-4 text-center">
                            <button type="button" onclick="event.stopPropagation(); openDetailModal('${p.id}')" class="inline-flex items-center gap-1 px-2.5 py-1.5 rounded-lg bg-slate-100 text-slate-700 text-xs font-semibold hover:bg-blue-600 hover:text-white transition">
                                추이 보기
                            </button>
                        </td>
                    </tr>
                `;
            }).join('');
        }

        function renderManagerKPIs(list) {
            const container = document.getElementById('manager-kpi-cards');
            if (!list.length) return;

            const teamLatestAvgDist = Math.round(list.reduce((s, p) => s + p.latest.distance, 0) / list.length);
            const teamAllTimeAvgDist = Math.round(list.reduce((s, p) => s + p.avgDistAll, 0) / list.length);
            const teamAvgHrPct = (list.reduce((s, p) => s + p.displayHrPct, 0) / list.length).toFixed(1);
            const improvingCount = list.filter(p => p.trendStatus === 'improving').length;
            const decliningCount = list.filter(p => p.trendStatus === 'declining').length;
            const totalRecords = list.reduce((s, p) => s + p.count, 0);

            container.innerHTML = `
                <div class="bg-white rounded-2xl border border-slate-200/90 p-4 shadow-sm">
                    <p class="text-xs font-semibold text-slate-500">팀 최근 평균 거리</p>
                    <div class="flex items-baseline gap-1 mt-1">
                        <span class="text-2xl font-extrabold text-slate-900">${teamLatestAvgDist.toLocaleString()}</span>
                        <span class="text-xs font-semibold text-slate-500">m</span>
                    </div>
                    <p class="text-[11px] text-blue-600 font-semibold mt-1">누적 전체 평균: ${teamAllTimeAvgDist.toLocaleString()}m</p>
                </div>

                <div class="bg-white rounded-2xl border border-slate-200/90 p-4 shadow-sm">
                    <p class="text-xs font-semibold text-slate-500">팀 평균 심박 사용률</p>
                    <div class="flex items-baseline gap-1 mt-1">
                        <span class="text-2xl font-extrabold text-rose-600">${teamAvgHrPct}</span>
                        <span class="text-xs font-semibold text-slate-500">% HRmax</span>
                    </div>
                    <p class="text-[11px] text-slate-500 mt-1">${metricMode === 'latest' ? '최근 측정 기준' : '전체 누적 평균 기준'}</p>
                </div>

                <div class="bg-white rounded-2xl border border-slate-200/90 p-4 shadow-sm">
                    <p class="text-xs font-semibold text-slate-500">직전 대비 성장 / 퇴화</p>
                    <div class="flex items-baseline gap-2 mt-1">
                        <span class="text-xl font-extrabold text-emerald-600">▲ ${improvingCount}명</span>
                        <span class="text-slate-300">/</span>
                        <span class="text-xl font-extrabold text-rose-600">▼ ${decliningCount}명</span>
                    </div>
                    <p class="text-[11px] text-slate-400 mt-1">거리 ±15m 이상 변동 기준</p>
                </div>

                <div class="bg-white rounded-2xl border border-slate-200/90 p-4 shadow-sm">
                    <p class="text-xs font-semibold text-slate-500">누적 측정 데이터</p>
                    <div class="flex items-baseline gap-1 mt-1">
                        <span class="text-2xl font-extrabold text-slate-900">${totalRecords}</span>
                        <span class="text-xs font-semibold text-slate-500">건</span>
                    </div>
                    <p class="text-[11px] text-slate-400 mt-1">등록 선수 ${list.length}명 평균 ${(totalRecords / list.length).toFixed(1)}회</p>
                </div>
            `;
        }

        function renderTeamTrendAndZones(list) {
            const improving = list.filter(p => p.trendStatus === 'improving').length;
            const stable = list.filter(p => p.trendStatus === 'stable').length;
            const declining = list.filter(p => p.trendStatus === 'declining').length;

            document.getElementById('team-trend-summary').innerHTML = `
                <div class="p-2.5 rounded-xl bg-emerald-50 border border-emerald-200 text-center">
                    <div class="text-[10px] font-bold text-emerald-700">성장 ▲</div>
                    <div class="text-lg font-extrabold text-emerald-800">${improving}명</div>
                </div>
                <div class="p-2.5 rounded-xl bg-slate-50 border border-slate-200 text-center">
                    <div class="text-[10px] font-bold text-slate-600">유지 -</div>
                    <div class="text-lg font-extrabold text-slate-800">${stable}명</div>
                </div>
                <div class="p-2.5 rounded-xl bg-rose-50 border border-rose-200 text-center">
                    <div class="text-[10px] font-bold text-rose-700">퇴화 ▼</div>
                    <div class="text-lg font-extrabold text-rose-800">${declining}명</div>
                </div>
            `;

            const total = list.length || 1;
            const zones = [
                { label: 'Zone 5 (90%+ 최대부하)', count: list.filter(p => p.displayHrPct >= 90).length, color: 'bg-rose-500' },
                { label: 'Zone 4 (80~89% 고강도)', count: list.filter(p => p.displayHrPct >= 80 && p.displayHrPct < 90).length, color: 'bg-orange-500' },
                { label: 'Zone 3 (70~79% 유산소)', count: list.filter(p => p.displayHrPct >= 70 && p.displayHrPct < 80).length, color: 'bg-emerald-500' }
            ];

            document.getElementById('hr-zone-distribution').innerHTML = zones.map(z => {
                const pct = Math.round((z.count / total) * 100);
                return `
                    <div>
                        <div class="flex justify-between text-xs mb-1">
                            <span class="font-semibold text-slate-700">${z.label}</span>
                            <span class="font-bold text-slate-900">${z.count}명 (${pct}%)</span>
                        </div>
                        <div class="w-full h-2 bg-slate-100 rounded-full overflow-hidden">
                            <div class="h-full ${z.color} rounded-full" style="width: ${pct}%"></div>
                        </div>
                    </div>
                `;
            }).join('');
        }

        function renderTeamOverviewChart(list) {
            const ctx = document.getElementById('teamOverviewChart').getContext('2d');
            if (teamOverviewChartInstance) teamOverviewChartInstance.destroy();

            const top = list.slice(0, 10);
            teamOverviewChartInstance = new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: top.map(p => p.name),
                    datasets: [
                        {
                            label: '%HRmax (평균)',
                            data: top.map(p => p.displayHrPct),
                            type: 'line',
                            yAxisID: 'y1',
                            borderColor: '#e11d48',
                            backgroundColor: '#e11d48',
                            borderWidth: 2.5,
                            pointRadius: 4,
                            tension: 0.3
                        },
                        {
                            label: '최근 12분 거리 (m)',
                            data: top.map(p => p.latest.distance),
                            yAxisID: 'y',
                            backgroundColor: 'rgba(37, 99, 235, 0.85)',
                            borderRadius: 6,
                            maxBarThickness: 22
                        },
                        {
                            label: '누적 평균 거리 (m)',
                            data: top.map(p => p.avgDistAll),
                            yAxisID: 'y',
                            backgroundColor: 'rgba(148, 163, 184, 0.55)',
                            borderRadius: 6,
                            maxBarThickness: 22
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    interaction: { mode: 'index', intersect: false },
                    plugins: { legend: { position: 'bottom', labels: { boxWidth: 12, font: { size: 11 } } } },
                    scales: {
                        y: { position: 'left', min: 2200, title: { display: true, text: '거리 (m)', font: { size: 11 } }, grid: { color: '#f1f5f9' } },
                        y1: { position: 'right', min: 65, max: 100, title: { display: true, text: '%HRmax', font: { size: 11 } }, grid: { drawOnChartArea: false } },
                        x: { grid: { display: false } }
                    }
                }
            });
        }

        // ---------------------------------------------------------
        // 6. 선수 개인 화면 렌더링
        // ---------------------------------------------------------
        function populatePlayerSelector() {
            const list = getEnrichedPlayers();
            const select = document.getElementById('player-selector');
            select.innerHTML = list.map(p =>
                `<option value="${p.id}" ${p.id === selectedPlayerId ? 'selected' : ''}>${p.name} (${p.position} · 만 ${p.age}세)</option>`
            ).join('');
            if (!list.find(p => p.id === selectedPlayerId) && list.length) selectedPlayerId = list[0].id;
        }

        function renderPlayerView() {
            const select = document.getElementById('player-selector');
            if (select.value) selectedPlayerId = select.value;

            const list = getEnrichedPlayers();
            const me = list.find(p => p.id === selectedPlayerId) || list[0];
            if (!me) return;

            document.getElementById('player-avatar').textContent = me.name.slice(0, 2);
            document.getElementById('player-record-count-badge').textContent = `누적 ${me.count}회 측정`;
            document.getElementById('player-test-date').textContent = me.latest.date;

            renderPlayerWatchSyncCard(me);

            document.getElementById('player-grade-badge').textContent = me.latest.grade.label;
            document.getElementById('player-distance').textContent = me.latest.distance.toLocaleString();
            document.getElementById('player-avg-dist-hero').textContent = `${me.avgDistAll.toLocaleString()}m`;
            document.getElementById('player-rank').textContent = `${me.rank}위`;
            document.getElementById('player-total-count').textContent = `/ ${list.length}명`;
            document.getElementById('player-best-dist').textContent = `${me.bestDist.toLocaleString()}m`;

            const trendBadge = document.getElementById('player-trend-hero-badge');
            if (me.count < 2) {
                trendBadge.className = 'inline-flex items-center gap-1 px-3 py-1 rounded-full text-xs font-bold bg-white/15 text-slate-200';
                trendBadge.textContent = '첫 측정 기준 기록';
            } else if (me.deltaDist > 0) {
                trendBadge.className = 'inline-flex items-center gap-1 px-3 py-1 rounded-full text-xs font-bold bg-emerald-500/25 text-emerald-200 border border-emerald-400/40';
                trendBadge.textContent = `▲ 직전 대비 +${me.deltaDist}m 성장`;
            } else if (me.deltaDist < 0) {
                trendBadge.className = 'inline-flex items-center gap-1 px-3 py-1 rounded-full text-xs font-bold bg-rose-500/25 text-rose-200 border border-rose-400/40';
                trendBadge.textContent = `▼ 직전 대비 ${me.deltaDist}m 하락`;
            } else {
                trendBadge.className = 'inline-flex items-center gap-1 px-3 py-1 rounded-full text-xs font-bold bg-white/15 text-slate-200';
                trendBadge.textContent = '직전 기록 유지 (0m)';
            }

            const diffAvg = me.latest.distance - me.avgDistAll;
            document.getElementById('player-feedback-text').textContent =
                diffAvg >= 0
                    ? `최근 기록이 본인의 누적 평균(${me.avgDistAll.toLocaleString()}m)보다 +${diffAvg}m 높습니다. 좋은 상승세입니다!`
                    : `최근 기록이 본인의 누적 평균(${me.avgDistAll.toLocaleString()}m)보다 ${diffAvg}m 낮습니다. 회복과 페이스 조절에 신경 써보세요.`;

            document.getElementById('player-stat-avg-dist').textContent = me.avgDistAll.toLocaleString();
            document.getElementById('player-stat-avg-vo2').textContent = `누적 평균 VO2 ${me.avgVo2All}`;
            document.getElementById('player-stat-avg-hrpct').textContent = me.avgHrPctAll;
            document.getElementById('player-max-hr').textContent = me.maxHR;
            document.getElementById('player-avg-hr').textContent = me.latest.avgHR;
            document.getElementById('player-peak-hr').textContent = me.latest.peakHR;
            document.getElementById('player-pace').textContent = calcPace(me.latest.distance);
            document.getElementById('player-last-device').textContent = `${me.latest.device} 연동`;

            renderPlayerProgressChart(me);
            renderPlayerHrChart(me);

            const board = document.getElementById('player-mini-leaderboard');
            board.innerHTML = list.map(p => {
                const isMe = p.id === me.id;
                const deltaTag = p.count >= 2
                    ? (p.deltaDist > 0 ? `<span class="text-[11px] font-bold text-emerald-600 ml-1">▲+${p.deltaDist}</span>`
                      : p.deltaDist < 0 ? `<span class="text-[11px] font-bold text-rose-600 ml-1">▼${p.deltaDist}</span>` : '')
                    : '';
                return `
                    <div class="flex items-center justify-between p-3 rounded-xl border ${isMe ? 'bg-blue-50 border-blue-300 shadow-sm' : 'bg-white border-slate-100'}">
                        <div class="flex items-center gap-3">
                            <span class="w-6 text-center text-sm font-extrabold ${p.rank <= 3 ? 'text-amber-600' : 'text-slate-400'}">${p.rank}</span>
                            <span class="text-sm font-bold ${isMe ? 'text-blue-900' : 'text-slate-800'}">
                                ${p.name} ${isMe ? '<span class="ml-1 text-[10px] px-1.5 py-0.5 rounded bg-blue-600 text-white">나</span>' : ''}
                            </span>
                            <span class="text-xs text-slate-400">${p.position}</span>
                        </div>
                        <div class="text-right">
                            <span class="text-sm font-extrabold ${isMe ? 'text-blue-700' : 'text-slate-900'}">${p.latest.distance.toLocaleString()}m</span>
                            ${deltaTag}
                        </div>
                    </div>
                `;
            }).join('');
        }

        function renderPlayerProgressChart(player) {
            const ctx = document.getElementById('playerProgressChart').getContext('2d');
            if (playerProgressChartInstance) playerProgressChartInstance.destroy();

            playerProgressChartInstance = new Chart(ctx, {
                type: 'line',
                data: {
                    labels: player.records.map((r, i) => `${i + 1}차 (${r.date.slice(5)})`),
                    datasets: [
                        {
                            label: '12분 거리 (m)',
                            data: player.records.map(r => r.distance),
                            yAxisID: 'y',
                            borderColor: '#2563eb',
                            backgroundColor: 'rgba(37, 99, 235, 0.1)',
                            borderWidth: 3,
                            fill: true,
                            tension: 0.3,
                            pointRadius: 5
                        },
                        {
