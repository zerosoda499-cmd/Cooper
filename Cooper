        function renderSplitInputs(presetValues = null) {
            const dist = parseInt(document.getElementById('input-distance').value, 10) || 3000;
            const maxHR = calcMaxHR(getActiveFormAge());
            const container = document.getElementById('split-inputs-container');

            const checkpoints = [];
            for (let d = 400; d < dist; d += 400) checkpoints.push(d);
            if (checkpoints[checkpoints.length - 1] !== dist) checkpoints.push(dist);

            container.innerHTML = checkpoints.map((d, idx) => {
                const ratio = idx / Math.max(1, checkpoints.length - 1);
                const val = presetValues && presetValues[idx] ? presetValues[idx] : Math.round(maxHR * (0.72 + ratio * 0.21));
                return `
                    <div>
