                    </div>
                `;
            }).join('');
        }

        function haversineMeters(lat1, lon1, lat2, lon2) {
            const R = 6371000;
            const toRad = x => x * Math.PI / 180;
            const dLat = toRad(lat2 - lat1);
            const dLon = toRad(lon2 - lon1);
            const a = Math.sin(dLat / 2) ** 2 + Math.cos(toRad(lat1)) * Math.cos(toRad(lat2)) * Math.sin(dLon / 2) ** 2;
            return R * 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));
        }

        function handleWatchFileUpload(event) {
            const file = event.target.files[0];
            if (!file) return;

            const reader = new FileReader();
            reader.onload = (e) => {
                try {
                    const xmlText = e.target.result;
                    const parser = new DOMParser();
                    const xml = parser.parseFromString(xmlText, 'text/xml');

                    let totalDist = 0;
                    const samples = [];

                    const trkpts = xml.getElementsByTagName('trkpt');
                    if (trkpts.length > 1) {
                        let prevLat = null, prevLon = null;
                        for (let i = 0; i < trkpts.length; i++) {
                            const pt = trkpts[i];
                            const lat = parseFloat(pt.getAttribute('lat'));
                            const lon = parseFloat(pt.getAttribute('lon'));
                            if (prevLat !== null && !isNaN(lat) && !isNaN(lon)) {
                                totalDist += haversineMeters(prevLat, prevLon, lat, lon);
                            }
                            prevLat = lat; prevLon = lon;

                            const hrNode = pt.querySelector('hr, gpxtpx\\:hr, ns3\\:hr') || pt.getElementsByTagNameNS('*', 'hr')[0];
                            if (hrNode && !isNaN(parseInt(hrNode.textContent, 10))) {
                                samples.push({ cumDist: totalDist, hr: parseInt(hrNode.textContent, 10) });
                            }
                        }
                    } else {
                        const tpts = xml.getElementsByTagName('Trackpoint');
                        for (let i = 0; i < tpts.length; i++) {
                            const tp = tpts[i];
                            const distNode = tp.getElementsByTagName('DistanceMeters')[0];
                            const hrValNode = tp.querySelector('HeartRateBpm Value') || tp.getElementsByTagName('Value')[0];
                            if (distNode) totalDist = Math.max(totalDist, parseFloat(distNode.textContent) || 0);
                            if (hrValNode) {
                                samples.push({ cumDist: totalDist, hr: parseInt(hrValNode.textContent, 10) });
                            }
                        }
                    }

                    if (totalDist < 100) {
                        showToast('파일에서 유효한 GPS 거리 데이터를 찾지 못했습니다.', 'error');
                        return;
                    }

                    const roundedDist = Math.round(totalDist / 10) * 10;
                    document.getElementById('input-distance').value = roundedDist;

                    const checkpoints = [];
                    for (let d = 400; d < roundedDist; d += 400) checkpoints.push(d);
                    if (checkpoints[checkpoints.length - 1] !== roundedDist) checkpoints.push(roundedDist);

                    let presetHrs = null;
                    if (samples.length > 0) {
                        presetHrs = checkpoints.map((cp, idx) => {
                            const prevCp = idx === 0 ? 0 : checkpoints[idx - 1];
                            const bucket = samples.filter(s => s.cumDist > prevCp && s.cumDist <= cp);
                            if (bucket.length > 0) {
                                return Math.round(bucket.reduce((a, b) => a + b.hr, 0) / bucket.length);
                            }
                            return samples[samples.length - 1].hr;
                        });
                    }

                    renderSplitInputs(presetHrs);
                    showToast(`파일 파싱 완료! 총 ${roundedDist.toLocaleString()}m 및 구간 심박수를 적용했습니다.`, 'success');
                } catch (err) {
                    console.error(err);
                    showToast('GPX/TCX 파일 형식을 읽는 중 오류가 발생했습니다.', 'error');
                }
            };
            reader.readAsText(file);
            event.target.value = '';
        }

        async function connectBluetoothHR() {
            if (!navigator.bluetooth) {
                showToast('현재 브라우저는 Web Bluetooth를 지원하지 않습니다. 데스크톱/안드로이드 Chrome에서 이용해 주세요.', 'error');
                return;
            }
            try {
                bleDevice = await navigator.bluetooth.requestDevice({
                    filters: [{ services: ['heart_rate'] }]
                });
                const server = await bleDevice.gatt.connect();
                const service = await server.getPrimaryService('heart_rate');
                const char = await service.getCharacteristic('heart_rate_measurement');
                await char.startNotifications();

                document.getElementById('ble-status-box').classList.remove('hidden');
                char.addEventListener('characteristicvaluechanged', (ev) => {
                    const val = ev.target.value;
                    const flags = val.getUint8(0);
                    const hr = (flags & 0x01) ? val.getUint16(1, true) : val.getUint8(1);
                    document.getElementById('ble-live-hr').textContent = hr;
                });
                showToast(`${bleDevice.name || 'BLE 심박 기기'}에 연결되었습니다!`, 'success');
            } catch (err) {
                showToast('블루투스 기기 연결이 취소되었거나 지원 기기를 찾지 못했습니다.', 'info');
            }
        }

        function disconnectBluetoothHR() {
            if (bleDevice && bleDevice.gatt.connected) bleDevice.gatt.disconnect();
            document.getElementById('ble-status-box').classList.add('hidden');
            showToast('블루투스 심박 연결을 해제했습니다.', 'info');
        }

        function simulateWatchSync(deviceName) {
            document.getElementById('input-device').value = deviceName;
            let baseDist = 3050;
            if (recordTargetMode === 'existing') {
                const pid = document.getElementById('input-existing-player').value;
                const p = players.find(x => x.id === pid);
                if (p && p.records.length > 0) {
                    const last = p.records[p.records.length - 1].distance;
                    baseDist = last + Math.round((Math.random() * 170 - 60) / 10) * 10;
                }
            } else {
                const names = ['황인범', '이재성', '조규성', '백승호', '양현준'];
                document.getElementById('input-name').value = names[Math.floor(Math.random() * names.length)];
                baseDist = Math.round((Math.random() * 600 + 2800) / 10) * 10;
            }

            document.getElementById('input-distance').value = baseDist;
            const maxHR = calcMaxHR(getActiveFormAge());
            const count = Math.ceil(baseDist / 400);
            const preset = [];
            for (let i = 0; i < count; i++) {
                const ratio = i / Math.max(1, count - 1);
                const jitter = Math.floor(Math.random() * 5) - 2;
                preset.push(Math.min(maxHR, Math.round(maxHR * (0.71 + ratio * 0.21) + jitter)));
            }
            renderSplitInputs(preset);
            showToast(`${deviceName} GPS(${baseDist}m) 및 구간 심박 데이터를 불러왔습니다!`, 'success');
        }

        function handleRecordSubmit(e) {
