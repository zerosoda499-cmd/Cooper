            const splits = Array.from(document.querySelectorAll('.split-hr-input')).map(inp => ({
                dist: parseInt(inp.dataset.dist, 10),
                hr: parseInt(inp.value, 10)
            }));

            const newRec = { id: 'r_' + Date.now(), date, distance, device, splits };

            if (recordTargetMode === 'existing') {
                const pid = document.getElementById('input-existing-player').value;
                const p = players.find(x => x.id === pid);
                if (!p) return;
                p.records.push(newRec);
                selectedPlayerId = p.id;
                showToast(`${p.name} 선수의 ${p.records.length}회차 기록이 누적 저장되었습니다.`, 'success');
            } else {
                const name = document.getElementById('input-name').value.trim();
                const position = document.getElementById('input-position').value;
                const age = parseInt(document.getElementById('input-age').value, 10);
                if (!name) return;
                const newPlayer = {
                    id: 'p_' + Date.now(),
                    name,
                    position,
                    age,
                    watchSync: { connected: false, provider: 'Strava', device, lastSyncedAt: null },
                    records: [newRec]
                };
                players.push(newPlayer);
                selectedPlayerId = newPlayer.id;
                showToast(`${name} 선수가 등록되고 첫 기록이 저장되었습니다.`, 'success');
            }

            saveData();
            closeRecordModal();
            renderAll();
        }

        // ---------------------------------------------------------
        // 8-B. 원클릭 자동 동기화 (Strava 클라우드 허브 연동 흐름)
        // ---------------------------------------------------------
        function formatNowTimestamp() {
            const now = new Date();
            const yyyy = now.getFullYear();
            const mm = String(now.getMonth() + 1).padStart(2, '0');
            const dd = String(now.getDate()).padStart(2, '0');
            const hh = String(now.getHours()).padStart(2, '0');
            const min = String(now.getMinutes()).padStart(2, '0');
            return { date: `${yyyy}-${mm}-${dd}`, timestamp: `${yyyy}-${mm}-${dd} ${hh}:${min}` };
        }

        function renderPlayerWatchSyncCard(player) {
            const card = document.getElementById('player-watch-sync-card');
            if (!card) return;
            const sync = player.watchSync || { connected: false, device: 'Apple Watch', lastSyncedAt: null };

            if (sync.connected) {
                const deviceEmoji = sync.device === 'Apple Watch' ? '🍎' : '⌚';
                card.innerHTML = `
                    <div class="flex items-center gap-3">
                        <div class="w-10 h-10 rounded-xl bg-orange-50 border border-orange-200 flex items-center justify-center text-lg shrink-0">${deviceEmoji}</div>
                        <div>
                            <div class="flex items-center gap-1.5">
                                <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
                                <span class="text-xs sm:text-sm font-extrabold text-slate-900">${sync.device} 자동 연동 중</span>
                                <span class="text-[10px] font-bold px-1.5 py-0.5 rounded bg-orange-100 text-orange-700">Strava 허브</span>
                            </div>
                            <p class="text-[11px] text-slate-500 mt-0.5">마지막 동기화: ${sync.lastSyncedAt || '방금 전'} · 워치 운동 종료 후 버튼만 누르세요.</p>
                        </div>
                    </div>
                    <div class="flex items-center gap-2">
                        <button onclick="syncSinglePlayerWatch('${player.id}')" class="flex-1 sm:flex-none inline-flex items-center justify-center gap-1.5 px-4 py-2 rounded-xl bg-gradient-to-r from-orange-500 to-rose-500 text-white text-xs sm:text-sm font-bold shadow-sm hover:from-orange-600 hover:to-rose-600 active:scale-[0.98] transition">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>
                            지금 바로 기록 불러오기
                        </button>
                        <button onclick="disconnectPlayerWatch('${player.id}')" class="px-2.5 py-2 rounded-xl text-xs font-semibold text-slate-400 hover:text-rose-600 hover:bg-rose-50 transition" title="워치 연동 해제">
                            해제
                        </button>
                    </div>
                `;
            } else {
                card.innerHTML = `
                    <div class="flex items-center gap-3">
                        <div class="w-10 h-10 rounded-xl bg-slate-100 border border-slate-200 flex items-center justify-center text-lg shrink-0">⌚</div>
                        <div>
                            <div class="text-xs sm:text-sm font-extrabold text-slate-900">워치 자동 연동이 아직 설정되지 않았습니다</div>
                            <p class="text-[11px] text-slate-500 mt-0.5">Apple Watch · Galaxy Watch를 최초 1회만 연결하면 파일 업로드 없이 자동 기록됩니다.</p>
                        </div>
                    </div>
                    <button onclick="openWatchConnectModal()" class="w-full sm:w-auto inline-flex items-center justify-center gap-1.5 px-4 py-2.5 rounded-xl bg-slate-900 text-white text-xs sm:text-sm font-bold hover:bg-slate-800 active:scale-[0.98] transition shadow-sm shrink-0">
                        <svg class="w-4 h-4 text-orange-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"/></svg>
                        내 워치 1회 연결하기
                    </button>
                `;
            }
        }

        function openWatchConnectModal() {
            pendingConnectDevice = 'Apple Watch';
            selectConnectDevice('Apple Watch');
            const m = document.getElementById('watch-connect-modal');
            m.classList.remove('hidden'); m.classList.add('flex');
        }

        function closeWatchConnectModal() {
            const m = document.getElementById('watch-connect-modal');
            m.classList.add('hidden'); m.classList.remove('flex');
        }

        function selectConnectDevice(device) {
            pendingConnectDevice = device;
            const btnApple = document.getElementById('connect-opt-apple');
            const btnGalaxy = document.getElementById('connect-opt-galaxy');
            if (device === 'Apple Watch') {
                btnApple.className = 'p-3 rounded-xl border-2 border-blue-600 bg-blue-50/70 text-left transition';
                btnGalaxy.className = 'p-3 rounded-xl border-2 border-slate-200 bg-white hover:bg-slate-50 text-left transition';
            } else {
                btnGalaxy.className = 'p-3 rounded-xl border-2 border-blue-600 bg-blue-50/70 text-left transition';
                btnApple.className = 'p-3 rounded-xl border-2 border-slate-200 bg-white hover:bg-slate-50 text-left transition';
            }
        }

        function confirmWatchOAuthConnect() {
            const p = players.find(x => x.id === selectedPlayerId);
            if (!p) return;

            const btn = document.getElementById('btn-confirm-oauth');
            btn.disabled = true;
            btn.innerHTML = `<span class="animate-spin inline-block w-4 h-4 border-2 border-white border-t-transparent rounded-full"></span> <span>Strava 클라우드 인증 중...</span>`;

            setTimeout(() => {
                const { timestamp } = formatNowTimestamp();
                p.watchSync = {
                    connected: true,
                    provider: 'Strava',
                    device: pendingConnectDevice,
                    lastSyncedAt: timestamp
                };
                saveData();
                btn.disabled = false;
                btn.innerHTML = `<span>Strava 계정으로 원클릭 연결 승인</span>`;
                closeWatchConnectModal();
                renderAll();
                showToast(`${p.name} 선수의 ${pendingConnectDevice} 자동 연동이 완료되었습니다!`, 'success');
            }, 700);
        }

        function disconnectPlayerWatch(playerId) {
            const p = players.find(x => x.id === playerId);
            if (!p) return;
            p.watchSync = { connected: false, provider: 'Strava', device: p.watchSync?.device || 'Apple Watch', lastSyncedAt: null };
            saveData();
            renderAll();
            showToast(`${p.name} 선수의 워치 자동 연동을 해제했습니다.`, 'info');
        }

        function buildSyncedRecordForPlayer(p, dateStr) {
            const lastRec = p.records[p.records.length - 1];
            const maxHR = calcMaxHR(p.age);
            const delta = Math.round((Math.random() * 130 - 40) / 10) * 10;
            const newDist = Math.max(1800, Math.min(4200, (lastRec ? lastRec.distance : 3000) + delta));
            const startHr = Math.round(maxHR * (0.71 + Math.random() * 0.03));
            const endHr = Math.min(maxHR, Math.round(maxHR * (0.91 + Math.random() * 0.04)));

            return {
                id: 'r_sync_' + Date.now() + '_' + Math.floor(Math.random() * 1000),
                date: dateStr,
                distance: newDist,
                device: (p.watchSync && p.watchSync.device) || 'Apple Watch',
                splits: makeSplits(newDist, startHr, endHr)
            };
        }

        function syncSinglePlayerWatch(playerId) {
            if (isSyncing) return;
            const p = players.find(x => x.id === playerId);
            if (!p || !p.watchSync || !p.watchSync.connected) return;

            isSyncing = true;
            showToast(`${p.watchSync.device} 최신 쿠퍼 테스트 기록을 불러오는 중...`, 'info');

            setTimeout(() => {
                const { date, timestamp } = formatNowTimestamp();
                const newRec = buildSyncedRecordForPlayer(p, date);
                p.records.push(newRec);
                p.watchSync.lastSyncedAt = timestamp;
                saveData();
                isSyncing = false;
                renderAll();
                showToast(`동기화 완료! ${p.name} 선수의 새 기록(${newRec.distance.toLocaleString()}m)이 반영되었습니다.`, 'success');
            }, 800);
        }

        function syncTeamAllWatches() {
            if (isSyncing) return;
            const connectedPlayers = players.filter(p => p.watchSync && p.watchSync.connected);
            if (connectedPlayers.length === 0) {
                showToast('자동 연동된 선수가 없습니다. 선수 개인 화면에서 워치를 먼저 연결해 주세요.', 'error');
                return;
            }

            isSyncing = true;
            const icon = document.getElementById('team-sync-icon');
            const label = document.getElementById('team-sync-label');
            if (icon) icon.classList.add('animate-spin');
            if (label) label.textContent = '워치 기록 일괄 동기화 중...';

            setTimeout(() => {
                const { date, timestamp } = formatNowTimestamp();
                connectedPlayers.forEach(p => {
                    const newRec = buildSyncedRecordForPlayer(p, date);
                    p.records.push(newRec);
                    p.watchSync.lastSyncedAt = timestamp;
                });

                saveData();
                isSyncing = false;
                if (icon) icon.classList.remove('animate-spin');
                renderAll();
                showToast(`원클릭 동기화 완료! 연동된 ${connectedPlayers.length}명의 최신 워치 기록이 누적되었습니다.`, 'success');
            }, 950);
        }

        // ---------------------------------------------------------
        // 9. 워치 가이드 모달, CSV 내보내기, 토스트
        // ---------------------------------------------------------
        function openWatchGuideModal() {
            const m = document.getElementById('watch-guide-modal');
            m.classList.remove('hidden'); m.classList.add('flex');
        }
        function closeWatchGuideModal() {
            const m = document.getElementById('watch-guide-modal');
            m.classList.add('hidden'); m.classList.remove('flex');
        }

        function exportCSV() {
            const list = getEnrichedPlayers();
            const headers = ['순위', '이름', '포지션', '나이', '측정횟수', '최근거리(m)', '누적평균거리(m)', '최고기록(m)', '직전대비변화(m)', '최대심박(220-나이)', '누적평균%HRmax', '최근측정일'];
            const rows = list.map(p => [
                p.rank, p.name, p.position, p.age, p.count, p.latest.distance, p.avgDistAll, p.bestDist,
                p.count >= 2 ? p.deltaDist : 0, p.maxHR, `${p.avgHrPctAll}%`, p.latest.date
            ]);
            const csv = '\uFEFF' + [headers.join(','), ...rows.map(r => r.join(','))].join('\n');
            const blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = `cooper_pro_longitudinal_${new Date().toISOString().split('T')[0]}.csv`;
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);
            URL.revokeObjectURL(url);
            showToast('누적 평균 및 성장 추이 리포트(CSV)를 다운로드했습니다.', 'success');
        }

        function showToast(message, type = 'info') {
            const container = document.getElementById('toast-container');
            const toast = document.createElement('div');
            const colors = { success: 'bg-emerald-600 text-white', error: 'bg-rose-600 text-white', info: 'bg-slate-800 text-white' };
            toast.className = `pointer-events-auto px-4 py-3 rounded-xl shadow-lg text-xs sm:text-sm font-semibold fade-in ${colors[type] || colors.info}`;
            toast.textContent = message;
            container.appendChild(toast);
            setTimeout(() => {
                toast.style.opacity = '0';
                toast.style.transition = 'opacity 0.3s ease';
                setTimeout(() => toast.remove(), 300);
            }, 3000);
        }

        window.addEventListener('click', (e) => {
            if (e.target.id === 'detail-modal') closeDetailModal();
            if (e.target.id === 'record-modal') closeRecordModal();
            if (e.target.id === 'watch-guide-modal') closeWatchGuideModal();
            if (e.target.id === 'watch-connect-modal') closeWatchConnectModal();
        });

        window.addEventListener('DOMContentLoaded', () => {
            loadData();
            switchRole('manager');
        });
    </script>
</body>
